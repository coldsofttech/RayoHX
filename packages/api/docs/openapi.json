{
  "components": {
    "schemas": {
      "CleanRequest": {
        "properties": {
          "dry_run": {
            "default": true,
            "title": "Dry Run",
            "type": "boolean"
          },
          "older_than_days": {
            "default": 0,
            "minimum": 0.0,
            "title": "Older Than Days",
            "type": "number"
          }
        },
        "title": "CleanRequest",
        "type": "object"
      },
      "CleanResponse": {
        "properties": {
          "dry_run": {
            "title": "Dry Run",
            "type": "boolean"
          },
          "folders": {
            "items": {
              "$ref": "#/components/schemas/CleanedFolder"
            },
            "title": "Folders",
            "type": "array"
          },
          "freed_bytes": {
            "title": "Freed Bytes",
            "type": "integer"
          },
          "skipped_in_use": {
            "title": "Skipped In Use",
            "type": "integer"
          }
        },
        "required": [
          "dry_run",
          "folders",
          "freed_bytes",
          "skipped_in_use"
        ],
        "title": "CleanResponse",
        "type": "object"
      },
      "CleanedFolder": {
        "properties": {
          "age_days": {
            "title": "Age Days",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "size_bytes",
          "age_days"
        ],
        "title": "CleanedFolder",
        "type": "object"
      },
      "DownloadCreate": {
        "properties": {
          "audio": {
            "items": {
              "type": "string"
            },
            "maxItems": 16,
            "title": "Audio",
            "type": "array"
          },
          "filename": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "File name inside the download folder. Folders are not accepted.",
            "title": "Filename"
          },
          "format": {
            "default": "auto",
            "enum": [
              "auto",
              "mp4",
              "mkv",
              "ts"
            ],
            "title": "Format",
            "type": "string"
          },
          "network": {
            "$ref": "#/components/schemas/Network"
          },
          "overwrite": {
            "default": false,
            "title": "Overwrite",
            "type": "boolean"
          },
          "quality": {
            "default": "best",
            "pattern": "(?i)^(best|worst|auto|\\d{3,4}p)$",
            "title": "Quality",
            "type": "string"
          },
          "subtitles": {
            "items": {
              "type": "string"
            },
            "maxItems": 16,
            "title": "Subtitles",
            "type": "array"
          },
          "url": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          },
          "video_only": {
            "default": false,
            "title": "Video Only",
            "type": "boolean"
          }
        },
        "required": [
          "url"
        ],
        "title": "DownloadCreate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "InspectRequest": {
        "properties": {
          "network": {
            "$ref": "#/components/schemas/Network"
          },
          "quality": {
            "default": "best",
            "pattern": "(?i)^(best|worst|auto|\\d{3,4}p)$",
            "title": "Quality",
            "type": "string"
          },
          "url": {
            "description": "Address of an HLS playlist.",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "InspectRequest",
        "type": "object"
      },
      "InspectResponse": {
        "description": "A master or media playlist as plain data (see ``rayohx.serialization``).",
        "properties": {
          "playlist": {
            "additionalProperties": true,
            "title": "Playlist",
            "type": "object"
          }
        },
        "required": [
          "playlist"
        ],
        "title": "InspectResponse",
        "type": "object"
      },
      "Job": {
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "number"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "output_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Path"
          },
          "output_size_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Size Bytes"
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Progress"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "number"
          },
          "url": {
            "description": "The address with any signing token removed.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "state",
          "created_at",
          "updated_at"
        ],
        "title": "Job",
        "type": "object"
      },
      "JobList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Job"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "JobList",
        "type": "object"
      },
      "Network": {
        "description": "Optional request settings applied when fetching the playlist.",
        "properties": {
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 32,
            "title": "Headers",
            "type": "object"
          }
        },
        "title": "Network",
        "type": "object"
      },
      "Progress": {
        "properties": {
          "active_workers": {
            "default": 0,
            "title": "Active Workers",
            "type": "integer"
          },
          "average_speed": {
            "default": 0.0,
            "title": "Average Speed",
            "type": "number"
          },
          "completed_segments": {
            "default": 0,
            "title": "Completed Segments",
            "type": "integer"
          },
          "downloaded_bytes": {
            "default": 0,
            "title": "Downloaded Bytes",
            "type": "integer"
          },
          "eta_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eta Seconds"
          },
          "fraction": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fraction"
          },
          "speed": {
            "default": 0.0,
            "title": "Speed",
            "type": "number"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "total_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Bytes"
          },
          "total_segments": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Segments"
          },
          "written_bytes": {
            "default": 0,
            "title": "Written Bytes",
            "type": "integer"
          }
        },
        "required": [
          "state"
        ],
        "title": "Progress",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Version of the running service.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "SettingsUpdate": {
        "properties": {
          "concurrency": {
            "anyOf": [
              {
                "maximum": 64.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Concurrency"
          },
          "overwrite": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overwrite"
          },
          "quality": {
            "anyOf": [
              {
                "pattern": "(?i)^(best|worst|auto|\\d{3,4}p)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quality"
          }
        },
        "title": "SettingsUpdate",
        "type": "object"
      },
      "SettingsView": {
        "properties": {
          "concurrency": {
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Concurrency",
            "type": "integer"
          },
          "download_dir": {
            "title": "Download Dir",
            "type": "string"
          },
          "max_active_downloads": {
            "title": "Max Active Downloads",
            "type": "integer"
          },
          "overwrite": {
            "default": false,
            "title": "Overwrite",
            "type": "boolean"
          },
          "quality": {
            "default": "best",
            "pattern": "(?i)^(best|worst|auto|\\d{3,4}p)$",
            "title": "Quality",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "download_dir",
          "max_active_downloads",
          "concurrency",
          "version"
        ],
        "title": "SettingsView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
